<Window x:Class="V3RttMonitor.App.CanLogMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="合并CAN日志" Icon="Assets/JustFloatMonitor.ico"
        Width="560" Height="470" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}">
    <Border Margin="14" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="多段CAN日志时间轴" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,18,0,10">
                <RadioButton x:Name="AppendContinuousRadio" GroupName="Merge" IsChecked="True" Checked="Mode_OnChanged">
                    <StackPanel Margin="6,2"><TextBlock Text="紧接上一段" FontWeight="SemiBold" /><TextBlock Text="把新日志起点平移到上一段末尾后的一个正常采样间隔" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="AppendGapRadio" GroupName="Merge" Checked="Mode_OnChanged" Margin="4,8,4,4">
                    <StackPanel Margin="6,2"><TextBlock Text="按指定间隔追加" FontWeight="SemiBold" /><TextBlock Text="保留清晰的段落边界，适合两次独立试验" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </RadioButton>
                <StackPanel Orientation="Horizontal" Margin="35,0,0,6">
                    <TextBlock Text="段间隔" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="GapTextBox" Text="1.0" Width="90" Margin="8,2" IsEnabled="False" />
                    <TextBlock Text="s" VerticalAlignment="Center" />
                </StackPanel>
                <RadioButton x:Name="PreserveRadio" GroupName="Merge" Checked="Mode_OnChanged" Margin="4">
                    <StackPanel Margin="6,2"><TextBlock Text="保留原始时间" FontWeight="SemiBold" /><TextBlock Text="按日志中的时间戳合并；时间范围重叠时两段会重叠显示" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </RadioButton>
                <RadioButton x:Name="ReplaceRadio" GroupName="Merge" Checked="Mode_OnChanged" Margin="4,8,4,4">
                    <StackPanel Margin="6,2"><TextBlock Text="替换当前数据" FontWeight="SemiBold" /><TextBlock Text="清空当前报文，只载入本次选择的日志" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" /></StackPanel>
                </RadioButton>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" MinWidth="90" Click="CancelButton_OnClick" />
                <Button Style="{StaticResource IconTextButton}" Tag="&#xE73E;" Content="开始合并" MinWidth="110" Background="#075985" BorderBrush="#38BDF8" Click="ConfirmButton_OnClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
