<Window x:Class="V3RttMonitor.App.CanAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:V3RttMonitor.App.Views"
        Title="JustFloat Studio · CAN工作台" Icon="Assets/JustFloatMonitor.ico"
        Width="1600" Height="940" MinWidth="1220" MinHeight="740"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_OnDrop"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button AutomationProperties.AutomationId="ReturnFromCanButton" Style="{StaticResource IconTextButton}" Tag="&#xE72B;" Content="返回启动中心" Click="ReturnButton_OnClick" Padding="11,6" ToolTip="隐藏CAN分析窗口并返回（Esc）" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Border Width="34" Height="34" CornerRadius="8" Background="#0C4A6E"><TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="CAN 工作台" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="在线硬件监控与离线日志分析相互独立，共用DBC解码和波形工具" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Esc 返回 · F11 切换窗口最大化" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="-3,0,-3,8">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="3" Padding="10,6"><StackPanel><TextBlock Text="保留报文" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" /><TextBlock Text="{Binding ActiveSession.FrameCountText}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="3" Padding="10,6"><StackPanel><TextBlock Text="报文ID" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" /><TextBlock Text="{Binding ActiveSession.MessageCountText}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="3" Padding="10,6"><StackPanel><TextBlock Text="时间范围" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" /><TextBlock Text="{Binding ActiveSession.DurationText}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="3" Padding="10,6"><StackPanel><TextBlock Text="平均接收率" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" /><TextBlock Text="{Binding ActiveSession.FrameRateText}" FontSize="16" FontWeight="SemiBold" /></StackPanel></Border>
        </UniformGrid>

        <TabControl x:Name="CanModeTabs" Grid.Row="2" SelectionChanged="CanModeTabs_OnSelectionChanged">
            <TabItem AutomationProperties.AutomationId="CanOnlineTab" Header="在线监控">
                <views:CanAnalysisView AutomationProperties.AutomationId="CanOnlineWorkspace" DataContext="{Binding Online}" />
            </TabItem>
            <TabItem AutomationProperties.AutomationId="CanOfflineTab" Header="离线分析">
                <views:CanAnalysisView AutomationProperties.AutomationId="CanOfflineWorkspace" DataContext="{Binding Offline}" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
