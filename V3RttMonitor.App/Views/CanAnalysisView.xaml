<UserControl x:Class="V3RttMonitor.App.Views.CanAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             x:Name="Root" Background="Transparent" Focusable="True">
    <UserControl.Resources>
        <Style x:Key="CanCleanupContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CanCleanupMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="#1E3A5F" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="MenuItemBorder" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootLayout">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="CatalogColumn" Width="460" MinWidth="340" /><ColumnDefinition x:Name="CatalogSplitterColumn" Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="6" /><RowDefinition Height="Auto" /><RowDefinition Height="3*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="报文与信号" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MessageCountText, StringFormat={}{0} IDs}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel Margin="0,4,0,0">
                        <Button AutomationProperties.AutomationId="LoadCanDbcButton" Style="{StaticResource CompactIconTextButton}" Tag="&#xE8E5;" Content="加载DBC解码" Click="LoadDbcButton_OnClick" />
                        <ComboBox Width="150" ItemsSource="{Binding DbcFiles}" DisplayMemberPath="DisplayText" SelectedItem="{Binding SelectedDbcFile}" ToolTip="已加载DBC；越靠后优先级越高" />
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE738;" Content="移除DBC" Click="RemoveDbcButton_OnClick" />
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE8E5;" Content="加载CAN日志" Click="LoadLogButton_OnClick" Visibility="{Binding IsOfflineWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE74D;" Content="清空接收缓存" Click="ClearDataButton_OnClick" Visibility="{Binding IsOnlineWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="保持CAN连接，只清空当前接收历史、统计和波形" />
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE74D;" Content="关闭数据集" Click="ClearDataButton_OnClick" Visibility="{Binding IsOfflineWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" ToolTip="关闭当前离线日志数据，保留DBC配置" />
                        <Button x:Name="CleanupMenuButton"
                                Style="{StaticResource CompactIconTextButton}"
                                Tag="&#xE74D;"
                                Content="清理 ▾"
                                Click="CleanupMenuButton_OnClick"
                                ToolTip="集中管理报文数据、绘图信号、游标和视图">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource CanCleanupContextMenu}" ItemContainerStyle="{StaticResource CanCleanupMenuItem}">
                                    <MenuItem Header="取消全部绘图信号" Tag="&#xE894;" Click="ClearSignalsButton_OnClick" ToolTip="只取消绘图勾选，不删除报文和DBC" />
                                    <MenuItem Header="清除 A/B 游标" Tag="&#xE81E;" Click="ClearCursorsButton_OnClick" ToolTip="清除点选采样和双游标" />
                                    <MenuItem Header="恢复活动图视图" Tag="&#xE80F;" Click="HomeButton_OnClick" ToolTip="恢复自动范围并继续追踪最新数据" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </WrapPanel>
                    <Border Background="#10253B" BorderBrush="#1D4F73" BorderThickness="1" CornerRadius="5" Padding="7,5" Margin="2,5,2,0">
                        <StackPanel>
                            <TextBlock Text="{Binding DbcStatus}" Foreground="#7DD3FC" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding DbcPath}" />
                            <TextBlock Text="{Binding SourceStatus}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding LogPath}" />
                            <TextBlock Text="{Binding OnlineDiagnosticsText}" Foreground="#FBBF24" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding OnlineRawPreview}" Visibility="{Binding IsOnlineWorkspace, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border Background="#0B1220" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="7" Margin="2,5,2,0" Visibility="{Binding IsOnlineWorkspace, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="数据来源" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox AutomationProperties.AutomationId="CanSourceModeCombo" Grid.Column="1" ItemsSource="{Binding SourceModes}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedSourceMode}" ToolTip="硬件CAN直接打开适配器；网络CAN接收TCP文本或网关数据" />
                                <TextBlock Grid.Column="2" Text="{Binding SelectedSourceMode.Description}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button AutomationProperties.AutomationId="CanConnectButton" Style="{StaticResource CompactIconTextButton}" Tag="&#xE768;" Content="连接" Click="StartTcpButton_OnClick" Background="#075985" />
                                    <Button AutomationProperties.AutomationId="CanDisconnectButton" Style="{StaticResource CompactIconTextButton}" Tag="&#xE71A;" Content="断开" Click="StopTcpButton_OnClick" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Visibility="{Binding IsHardwareSource, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,5,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox AutomationProperties.AutomationId="CanHardwareEndpointCombo"
                                              IsTextSearchEnabled="True"
                                              ItemsSource="{Binding HardwareEndpoints}"
                                              DisplayMemberPath="DisplayText"
                                              SelectedItem="{Binding SelectedHardwareEndpoint}"
                                              ToolTip="选择ZLG设备型号、设备索引和通道；内部端点由软件生成" />
                                    <Button Grid.Column="1" AutomationProperties.AutomationId="RefreshCanHardwareButton" Style="{StaticResource CompactIconTextButton}" Tag="&#xE72C;" Content="刷新" Click="RefreshHardwareButton_OnClick" ToolTip="重新扫描已安装驱动和可发现通道" />
                                </Grid>
                                <WrapPanel Margin="0,3,0,0">
                                    <CheckBox Content="CAN FD" IsChecked="{Binding UseCanFd}" ToolTip="未勾选时使用经典CAN" />
                                    <TextBlock Text="仲裁" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="4,0,2,0" />
                                    <ComboBox Width="96" ItemsSource="{Binding NominalBitrates}" SelectedValuePath="Value" SelectedValue="{Binding NominalBitrate}" ToolTip="仲裁/经典CAN波特率" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding UseCanFd, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="数据" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="5,0,2,0" />
                                        <ComboBox Width="96" ItemsSource="{Binding DataBitrates}" SelectedValuePath="Value" SelectedValue="{Binding DataBitrate}" ToolTip="CAN FD数据段波特率" />
                                    </StackPanel>
                                    <CheckBox Content="只听" IsChecked="{Binding ListenOnly}" ToolTip="监听模式，不主动发送报文；是否ACK由具体适配器决定" />
                                    <CheckBox Content="120Ω" IsChecked="{Binding InternalTermination}" ToolTip="仅在硬件支持内部终端电阻时生效" />
                                </WrapPanel>
                            </StackPanel>

                            <Grid Grid.Row="1" Visibility="{Binding IsNetworkSource, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                <TextBlock Text="服务器" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1" Text="{Binding TcpHost}" ToolTip="CAN文本服务器或网络网关IP" />
                                <TextBlock Grid.Column="2" Text=":" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBox Grid.Column="3" Text="{Binding TcpPort}" ToolTip="每行一帧，支持candump、Vector ASC行或123#AABB格式" />
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding HardwareDiscoveryStatus}" Visibility="{Binding IsHardwareSource, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" Margin="3,4,3,0" ToolTip="{Binding HardwareDiscoveryStatus}" />
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,7,0,5">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="125" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" TextChanged="SearchBox_OnTextChanged" ToolTip="搜索十六进制ID、报文名、数据或信号名" />
                    <ComboBox x:Name="MessageScopeCombo" Grid.Column="1" SelectionChanged="FilterOption_OnChanged" ToolTip="报文目录范围">
                        <ComboBoxItem Content="全部报文" Tag="All" IsSelected="True" />
                        <ComboBoxItem Content="仅已接收" Tag="Received" />
                        <ComboBoxItem Content="DBC已定义" Tag="Dbc" />
                        <ComboBoxItem Content="DBC未定义" Tag="Undefined" />
                    </ComboBox>
                    <CheckBox Grid.Column="2" Content="★仅标记" IsChecked="{Binding FavoriteOnly}" Checked="FilterOption_OnChanged" Unchecked="FilterOption_OnChanged" ToolTip="只显示已标记的报文和信号" />
                </Grid>

                <ListBox x:Name="MessageList" Grid.Row="2" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" SelectionChanged="MessageList_OnSelectionChanged" BorderBrush="{StaticResource BorderBrush}" Background="#0B1220" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.AutomationId" Value="{Binding IdText}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="2" /><Setter Property="Margin" Value="0,1" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="75" /></Grid.ColumnDefinitions>
                                <CheckBox Content="★" IsChecked="{Binding IsFavorite}" Foreground="#FBBF24" FontSize="15" ToolTip="标记此报文" Click="Favorite_OnClick" />
                                <TextBlock Grid.Column="1" Text="{Binding IdText}" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastData}" Foreground="#64748B" FontFamily="Consolas" FontSize="10" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding CatalogStateText}" Foreground="#7DD3FC" FontSize="9" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CountText}" FontFamily="Consolas" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding RateText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#26344B" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ShowsPreview="True" ToolTip="拖动调整报文目录与信号目录高度" />

                <Grid Grid.Row="4" Margin="1,6,1,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="当前ID的DBC信号 / 原始Byte" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="勾选后绘图" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <ListBox x:Name="SignalList" Grid.Row="5" ItemsSource="{Binding Signals}" BorderBrush="{StaticResource BorderBrush}" Background="#0B1220" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="2" /><Setter Property="Margin" Value="0,1" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding DefinitionText}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="28" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="38" /><ColumnDefinition Width="58" /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
                                <Border Width="9" Height="9" CornerRadius="2" Background="{Binding ColorHex}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" AutomationProperties.AutomationId="{Binding StableKey}" IsChecked="{Binding IsPlotted}" Click="SignalCheckBox_OnClick" ToolTip="绘制此信号" />
                                <CheckBox Grid.Column="2" Content="★" IsChecked="{Binding IsFavorite}" Foreground="#FBBF24" ToolTip="标记此信号" Click="Favorite_OnClick" />
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DefinitionText}" Foreground="#64748B" FontSize="10" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding ValueText}" FontFamily="Consolas" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="5" Text="{Binding Unit}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                <TextBlock Grid.Column="6" Text="{Binding FrequencyText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <ComboBox Grid.Column="7" AutomationProperties.AutomationId="{Binding StableKey, StringFormat={}{0}:PlotGroup}" ItemsSource="{Binding PlotGroupOptions, ElementName=Root}" SelectedItem="{Binding PlotGroup, UpdateSourceTrigger=PropertyChanged}" ToolTip="分配到坐标图" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="6" Background="#0B1220" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,7,0,0">
                    <TextBlock x:Name="SelectionStatusText" Text="最多同时绘制8个信号；未加载DBC时可直接绘制Byte0~Byte63。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#26344B" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE" />

        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="PlotRow" Height="*" /><RowDefinition x:Name="ContentSplitterRow" Height="0" /><RowDefinition x:Name="RawRow" Height="0" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,6">
                    <WrapPanel>
                        <RadioButton x:Name="PointerModeButton" Style="{StaticResource IconModeButton}" GroupName="CanPlotInteraction" Tag="&#xE7C9;" Content="指针" IsChecked="True" Checked="PointerModeButton_OnChecked" />
                        <RadioButton x:Name="SampleModeButton" Style="{StaticResource IconModeButton}" GroupName="CanPlotInteraction" Tag="&#xE718;" Content="点选" Checked="SampleModeButton_OnChecked" />
                        <ToggleButton x:Name="DualCursorButton" AutomationProperties.AutomationId="CanDualCursorButton" Style="{StaticResource IconToggleButton}" Tag="&#xE81E;" Content="双游标" Checked="DualCursorButton_OnChecked" Unchecked="DualCursorButton_OnUnchecked" ToolTip="点选A/B两个采样点，查看Δt和ΔY" />
                        <RadioButton x:Name="RectangleZoomModeButton" AutomationProperties.AutomationId="CanRectangleZoomButton" Style="{StaticResource IconModeButton}" GroupName="CanPlotInteraction" Tag="&#xE71E;" Content="框选放大" Checked="RectangleZoomModeButton_OnChecked" ToolTip="左键拖出矩形范围进行放大" />
                        <ToggleButton x:Name="PauseButton" Style="{StaticResource IconToggleButton}" Tag="&#xE769;" Content="暂停" Checked="PauseButton_OnChecked" Unchecked="PauseButton_OnUnchecked" />
                        <Separator Width="8" Opacity="0" />
                        <Button AutomationProperties.AutomationId="CanAddPlotButton" Style="{StaticResource CompactIconTextButton}" Tag="&#xE710;" Content="图" Click="AddPlotButton_OnClick" ToolTip="新增坐标图" />
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE738;" Content="图" Click="RemovePlotButton_OnClick" ToolTip="删除最后一个空坐标图" />
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE80F;" Content="复位" Click="HomeButton_OnClick" />
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE9D2;" Content="适配Y" Click="FitYButton_OnClick" />
                        <Button x:Name="MaximizeCanPlotButton" AutomationProperties.AutomationId="MaximizeCanPlotButton" Style="{StaticResource CompactIconTextButton}" Tag="&#xE740;" Content="最大化" Click="MaximizeCanPlotButton_OnClick" ToolTip="只显示当前蓝框坐标图" />
                    </WrapPanel>
                    <WrapPanel Margin="0,1,0,0">
                        <CheckBox x:Name="ShowPointsCheck" Content="采样点" Checked="DisplayOption_OnChanged" Unchecked="DisplayOption_OnChanged" />
                        <CheckBox x:Name="ShowLegendCheck" Content="图例" IsChecked="True" Checked="DisplayOption_OnChanged" Unchecked="DisplayOption_OnChanged" />
                        <CheckBox x:Name="AutoFollowCheck" Content="追踪最新" IsChecked="True" />
                        <TextBlock Text="时间窗口" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="12,0,3,0" />
                        <ComboBox x:Name="WindowCombo" AutomationProperties.AutomationId="CanTimeWindowCombo" Width="78" SelectionChanged="DisplayOption_OnChanged">
                            <ComboBoxItem Content="1 s" Tag="1" /><ComboBoxItem Content="5 s" Tag="5" />
                            <ComboBoxItem Content="10 s" Tag="10" /><ComboBoxItem Content="30 s" Tag="30" />
                            <ComboBoxItem Content="60 s" Tag="60" /><ComboBoxItem Content="全部" Tag="0" IsSelected="True" />
                        </ComboBox>
                        <Button Style="{StaticResource CompactIconTextButton}" Tag="&#xE74E;" Content="导出PNG" Click="ExportPngButton_OnClick" />
                        <Separator Width="14" Opacity="0" />
                        <RadioButton x:Name="WaveformViewModeButton" AutomationProperties.AutomationId="CanWaveformViewMode" Style="{StaticResource IconModeButton}" GroupName="CanContentView" Tag="&#xE9D2;" Content="波形" IsChecked="True" Checked="ContentViewMode_OnChanged" />
                        <RadioButton x:Name="FramesViewModeButton" AutomationProperties.AutomationId="CanFramesViewMode" Style="{StaticResource IconModeButton}" GroupName="CanContentView" Tag="&#xE8A5;" Content="报文" Checked="ContentViewMode_OnChanged" />
                        <RadioButton x:Name="SplitViewModeButton" AutomationProperties.AutomationId="CanSplitViewMode" Style="{StaticResource IconModeButton}" GroupName="CanContentView" Tag="&#xE8A9;" Content="分屏" Checked="ContentViewMode_OnChanged" />
                        <ToggleButton x:Name="FocusWaveformButton" AutomationProperties.AutomationId="CanFocusWaveformButton" Style="{StaticResource IconToggleButton}" Tag="&#xE740;" Content="专注波形" Checked="FocusWaveformButton_OnChecked" Unchecked="FocusWaveformButton_OnUnchecked" />
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer x:Name="PlotScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#0B1220">
                    <StackPanel x:Name="PlotPanel" Margin="4" />
                </ScrollViewer>

                <GridSplitter x:Name="ContentSplitter" Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#26344B" Cursor="SizeNS" Visibility="Collapsed" />

                <Grid x:Name="RawDetailsPanel" Grid.Row="3" Margin="0,5,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="3,0,3,4">
                        <CheckBox x:Name="OnlySelectedMessageCheck" DockPanel.Dock="Right" Content="仅当前ID" IsChecked="False" Checked="RawFilter_OnChanged" Unchecked="RawFilter_OnChanged" />
                        <TextBlock Text="最近原始报文（最多3000行）" FontWeight="SemiBold" />
                    </DockPanel>
                    <DataGrid x:Name="RawFrameGrid" Grid.Row="1" ItemsSource="{Binding RecentFrames}" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间/s" Binding="{Binding TimeText}" Width="100" />
                            <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="42" />
                            <DataGridTextColumn Header="方向" Binding="{Binding DirectionText}" Width="52" />
                            <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="95" />
                            <DataGridTextColumn Header="报文名称" Binding="{Binding MessageName}" Width="150" />
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="68" />
                            <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="45" />
                            <DataGridTextColumn Header="Data" Binding="{Binding DataText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Border Grid.Row="4" Background="#0B1220" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,6,0,0">
                    <TextBlock x:Name="PlotStatusText" Text="选择报文并勾选信号后绘图；右键拖动平移，滚轮缩放，指针显示当前值。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>

        <!-- Legacy backing controls kept collapsed while the active CAN plots are created dynamically. -->
        <Grid Visibility="Collapsed" Width="0" Height="0">
            <scottPlot:WpfPlot x:Name="CanPlot" />
            <Border x:Name="DataTip"><TextBlock x:Name="DataTipText" /></Border>
        </Grid>
    </Grid>
</UserControl>
