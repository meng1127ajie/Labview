<Window x:Class="V3RttMonitor.App.ExitConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认退出" Width="520" Height="365"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border Margin="16" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="#132238" CornerRadius="14,14,0,0" Padding="20,15" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" FontSize="22" FontFamily="Segoe UI" Width="36" Height="32" Padding="0" Margin="8,0,0,0" Click="CancelButton_OnClick" ToolTip="继续使用" />
                    <Image Source="{StaticResource AppIcon}" Width="42" Height="42" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="确认退出 JustFloat Studio？" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="当前连接和记录资源将被安全释放" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,14">
                <Border Background="#2A1E12" BorderBrush="#92400E" BorderThickness="1" CornerRadius="7" Padding="12,9">
                    <DockPanel>
                        <TextBlock Text="!" FontSize="17" FontWeight="Bold" Foreground="#FBBF24" Margin="2,0,11,0" VerticalAlignment="Center" />
                        <TextBlock Text="为了防止误操作，请确认是否结束本次监控。" Foreground="#FDE68A" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <TextBlock Text="确认退出后，软件会依次完成：" FontWeight="SemiBold" Margin="2,16,0,9" />
                <Grid Margin="4,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /></Grid.RowDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="停止J-Link / TCP接收与自动重连" VerticalAlignment="Center" />
                    <Ellipse Grid.Row="1" Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="写完并关闭正在记录的BIN文件" VerticalAlignment="Center" />
                    <Ellipse Grid.Row="2" Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="释放本软件启动的J-Link进程树" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <Border Grid.Row="2" Background="#0B1220" CornerRadius="0,0,14,14" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="继续使用" MinWidth="108" IsDefault="True" Click="CancelButton_OnClick" />
                    <Button AutomationProperties.AutomationId="SafeExitButton" Style="{StaticResource IconTextButton}" Tag="&#xE7E8;" Content="安全退出" MinWidth="118" Background="#B45309" BorderBrush="#F59E0B" Click="ConfirmButton_OnClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
