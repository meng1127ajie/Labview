<Window x:Class="V3RttMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustFloat Studio" Icon="Assets/JustFloatMonitor.ico"
        Width="1040" Height="680" MinWidth="900" MinHeight="600"
        WindowState="Normal" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="MainWindow_OnDrop"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Margin="2,0,2,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource AppIcon}" Width="56" Height="56" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="JustFloat Studio" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="嵌入式实时采集与信号分析工作室" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding ConnectionModeDisplayName}" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
                            <TextBlock Text=" · " Foreground="#64748B" FontSize="10" />
                            <TextBlock Text="{Binding ConnectionDetail}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="#0D1B2E" BorderBrush="#1D4F73" BorderThickness="1" CornerRadius="10" Padding="16,11" Margin="2,0,2,15">
            <DockPanel>
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="选择一个工作区开始" FontWeight="SemiBold" />
                    <TextBlock Text="各模块共享数据但界面彼此独立；关闭工作区会返回这里，不会主动断开后台采集。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="#285070" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="58" Height="58" CornerRadius="15" Background="#0C4A6E" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,17,0,0">
                        <TextBlock Text="J-Link 数据采集" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="RTT · HSS · TCP" Foreground="#7DD3FC" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="选择连接来源并开始采集；收到信号后在同一工作台进入波形分析，返回时回到连接设置。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,13,0,10" />
                    <Button Grid.Row="3" AutomationProperties.AutomationId="OpenAcquisitionWorkspaceButton" Style="{StaticResource IconTextButton}" Tag="&#xE8A7;" Content="进入J-Link采集" Click="OpenAcquisitionButton_OnClick" Background="#075985" BorderBrush="#38BDF8" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="#285B45" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="58" Height="58" CornerRadius="15" Background="#064E3B" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,17,0,0">
                        <TextBlock Text="CAN 报文分析" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="接收 · 搜索 · 曲线" Foreground="#6EE7B7" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="接收在线CAN文本流或打开ASC/candump日志，按帧ID搜索标记、加载DBC解码并绘制信号。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,13,0,10" />
                    <Button Grid.Row="3" AutomationProperties.AutomationId="OpenCanAnalysisButton" Style="{StaticResource IconTextButton}" Tag="&#xE8A7;" Content="进入CAN分析" Click="OpenCanAnalysisButton_OnClick" Background="#047857" BorderBrush="#34D399" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="#765127" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Width="58" Height="58" CornerRadius="15" Background="#713F12" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="29" Foreground="#FBBF24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,17,0,0">
                        <TextBlock Text="DBC 制作器" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="报文 · 信号 · 位布局" Foreground="#FDE68A" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="独立创建或修改DBC，选择Intel/Motorola位序，并用Byte/Bit图检查读取顺序、越界和重叠。" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" LineHeight="20" Margin="0,13,0,10" />
                    <Button Grid.Row="3" AutomationProperties.AutomationId="OpenStandaloneDbcEditorButton" Style="{StaticResource IconTextButton}" Tag="&#xE8A7;" Content="打开DBC制作器" Click="OpenDbcEditorButton_OnClick" Background="#B45309" BorderBrush="#FBBF24" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13,9" Margin="2,15,2,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前数据" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding FrameCountText, StringFormat={}{0} 帧}" FontWeight="SemiBold" />
                    <TextBlock Text=" · " Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding SchemaText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding TemplateStatusText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="12,0" />
                <TextBlock Grid.Column="2" Text="拖入 BIN / Excel / ELF / DBC / BLF / ASC 可自动进入对应工作区" Foreground="#7DD3FC" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="4,10,4,0">
            <TextBlock DockPanel.Dock="Right" Text="v1.5.0" Foreground="#64748B" />
            <TextBlock Text="模块化工作区结构可继续扩展串口、以太网、UDS及其他总线分析。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" />
        </DockPanel>

        <Border x:Name="ClosingOverlay" Grid.RowSpan="5" Panel.ZIndex="100" Visibility="Collapsed" Background="#E6080E1A" CornerRadius="12">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="430" Background="{StaticResource PanelRaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="28,24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="{StaticResource AppIcon}" Width="36" Height="36" Margin="0,0,12,0" />
                        <TextBlock Text="正在安全关闭" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ClosingStatusText" Text="正在停止接收并释放J-Link、CAN和文件资源…" Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" Margin="0,14,0,12" TextWrapping="Wrap" />
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="请稍候，不要从任务管理器强制结束进程。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" TextAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
